<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- «تحديث التطبيق»: installs both apps' updates from the GitHub releases (AppInstaller). The user allows it
         once («تثبيت التطبيقات غير المعروفة» for سعودي TV); Android confirms each install unless this app is
         updating itself or an app it installed before (UPDATE_PACKAGES_WITHOUT_USER_ACTION, Android 12+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- the launcher (same signing key) reads the settings for its home-screen card -->
    <permission
        android:name="com.raad.sauditv.screensaver.READ_CONFIG"
        android:protectionLevel="signature" />

    <!-- opens the launcher's «ترتيب المفضلة» from settings; reads its version for «تحديث التطبيق»; and whether the
         TV has a VPN app at all (VpnStatus.appInstalled: without one the VPN badge is hidden) -->
    <queries>
        <package android:name="com.raad.sauditv.home" />
        <intent>
            <action android:name="android.net.VpnService" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- opening the app shows its settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- full-screen preview; any remote key closes it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service
            android:name=".ScreenDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- each install session's result (AppInstaller); only Android's installer reaches it, through our PendingIntent -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- settings from ADB (agents, optimize/saver.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".SaverReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.raad.sauditv.screensaver.GET" />
                <action android:name="com.raad.sauditv.screensaver.SET" />
                <action android:name="com.raad.sauditv.screensaver.CITIES" />
                <action android:name="com.raad.sauditv.screensaver.UPDATE" />
                <action android:name="com.raad.sauditv.screensaver.APP_CHECK" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ConfigProvider"
            android:authorities="com.raad.sauditv.screensaver.config"
            android:exported="true"
            android:readPermission="com.raad.sauditv.screensaver.READ_CONFIG" />
    </application>
</manifest>
