<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- «تحديث التطبيق»: installs both apps' updates from the GitHub releases (AppInstaller). The user allows it
         once («تثبيت التطبيقات غير المعروفة» for سعودي TV); Android confirms each install unless this app is
         updating itself or an app it installed before (UPDATE_PACKAGES_WITHOUT_USER_ACTION, Android 12+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- «الأذان» (AthanScheduler, AthanService): an exact alarm at each prayer time (Android 12: SCHEDULE_EXACT_ALARM,
         granted at install; 13+: USE_EXACT_ALARM, granted at install, never revocable; 10 and 11 need neither); a
         foreground service for the athan's minutes; its screen and banner over any app (SYSTEM_ALERT_WINDOW: granted by
         `optimize/saver.sh athan on` through ADB, or once in the TV's «الظهور فوق التطبيقات»); WAKE_LOCK keeps the
         screen on while it plays, and brings a TV that is on out of a screensaver (never one in standby) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- the launcher (same signing key) reads the settings for its home-screen card, binds the radio (RadioService)
         and turns it on or off (ConfigProvider /radio) -->
    <permission
        android:name="com.raad.sauditv.screensaver.READ_CONFIG"
        android:protectionLevel="signature" />

    <!-- opens the launcher's «ترتيب المفضلة» from settings; reads its version for «تحديث التطبيق»; and whether the
         TV has a VPN app at all (VpnStatus.appInstalled: without one the VPN badge is hidden) -->
    <queries>
        <package android:name="com.raad.sauditv.home" />
        <intent>
            <action android:name="android.net.VpnService" />
        </intent>
        <!-- a VPN app's VpnService is often not exported (Surfshark's), and Android then grants no visibility through
             the intent above: the apps with a TV or phone launcher icon make it visible (as the launcher sees them) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- «الأذان»: whether this TV has the settings pages that grant its permissions (AthanSettings: the row opens
             the page, or says it is missing and how to grant it over ADB) -->
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_SCHEDULE_EXACT_ALARM" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- usesCleartextTraffic: «إذاعة القرآن الكريم» streams are often http:// (Radiojar sends its https:// address on to
         an http:// node; Shoutcast servers, «رابط من عندي»); everything else this app reads is https:// -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- opening the app shows its settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the first-run setup (a new install: the home screen opens it once per start, the settings on opening, until it
             is finished or skipped); «معالج الإعداد» in the settings and optimize/saver.sh setup open it again -->
        <activity
            android:name=".SetupActivity"
            android:exported="true" />

        <!-- full-screen preview; any remote key closes it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service
            android:name=".ScreenDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <!-- «إذاعة القرآن الكريم»: bound while one of our screens is in front (the home screen: same key, READ_CONFIG) -->
        <service
            android:name=".RadioService"
            android:exported="true"
            android:permission="com.raad.sauditv.screensaver.READ_CONFIG">
            <intent-filter>
                <action android:name="com.raad.sauditv.screensaver.RADIO" />
                <data android:scheme="sauditv-radio" />
            </intent-filter>
        </service>

        <!-- the athan's hook into the radio, for our other app (same key): RadioService's PAUSE_FOR_ATHAN / RESUME_AFTER_ATHAN -->
        <receiver
            android:name=".RadioReceiver"
            android:exported="true"
            android:permission="com.raad.sauditv.screensaver.READ_CONFIG">
            <intent-filter>
                <action android:name="com.raad.sauditv.screensaver.PAUSE_FOR_ATHAN" />
                <action android:name="com.raad.sauditv.screensaver.RESUME_AFTER_ATHAN" />
            </intent-filter>
        </receiver>

        <!-- «الأذان»: the alarm (only our own PendingIntent reaches it), the athan's minutes, its full-screen page (in a
             task of its own, out of the recent apps, so closing it goes back to whatever was in front) -->
        <receiver
            android:name=".AthanReceiver"
            android:exported="false" />
        <service
            android:name=".AthanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".AthanActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.raad.sauditv.athan"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- the page's online prayer times for the athan (Aladhan): a job, so it waits for the network and is retried -->
        <service
            android:name=".AthanOnline"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- the athan's alarm again (AthanScheduler) when the clock, the time zone or the exact-alarm permission change -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- each install session's result (AppInstaller); only Android's installer reaches it, through our PendingIntent -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- settings from ADB (agents, optimize/saver.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".SaverReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.raad.sauditv.screensaver.GET" />
                <action android:name="com.raad.sauditv.screensaver.SET" />
                <action android:name="com.raad.sauditv.screensaver.CITIES" />
                <action android:name="com.raad.sauditv.screensaver.COUNTRIES" />
                <action android:name="com.raad.sauditv.screensaver.LEAGUES" />
                <action android:name="com.raad.sauditv.screensaver.UPDATE" />
                <action android:name="com.raad.sauditv.screensaver.APP_CHECK" />
                <action android:name="com.raad.sauditv.screensaver.RADIO_STATIONS" />
                <action android:name="com.raad.sauditv.screensaver.RADIO_TEST" />
                <action android:name="com.raad.sauditv.screensaver.PAUSE_FOR_ATHAN" />
                <action android:name="com.raad.sauditv.screensaver.RESUME_AFTER_ATHAN" />
                <action android:name="com.raad.sauditv.screensaver.ATHAN_TEST" />
                <action android:name="com.raad.sauditv.screensaver.ATHAN_SHOW" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ConfigProvider"
            android:authorities="com.raad.sauditv.screensaver.config"
            android:exported="true"
            android:readPermission="com.raad.sauditv.screensaver.READ_CONFIG"
            android:writePermission="com.raad.sauditv.screensaver.READ_CONFIG" />
    </application>
</manifest>
