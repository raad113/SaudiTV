<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen adapted from github.com/mihirgupta0900/tv-home (MIT). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />   <!-- hosted wallpapers, the optional card -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted over ADB at install. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- the optional home-screen card reads the screensaver's settings (signature permission, same key) -->
    <uses-permission android:name="com.raad.sauditv.screensaver.READ_CONFIG" />
    <!-- the quick-settings panel's Bluetooth tile opens the TV settings' «Pair accessory», which needs
         BLUETOOTH_CONNECT (Android 12+, a runtime permission: granted over ADB by optimize/install.sh);
         BLUETOOTH on Android 11 and older -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- apps with only an ordinary launcher activity (OEM stores and settings, phone apps) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- other home screens, left out of the grid -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="com.mediatek.wwtv.tvcenter" />   <!-- live_tv_package on MediaTek sets (Hisense and others) -->
        <package android:name="com.raad.sauditv.screensaver" />
        <!-- VPN apps (VpnStatus.appInstalled): without one the VPN badge, its flag and the panel's VPN mark are hidden -->
        <intent>
            <action android:name="android.net.VpnService" />
        </intent>
    </queries>

    <application
        android:label="سعودي TV"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- a home-card panel full screen (OK on the card); in the home task, not in recents -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:launchMode="standard"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Detail"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <!-- «ترتيب المفضلة»: the favourites as a list; also opened from the screensaver's settings -->
        <activity
            android:name=".DockActivity"
            android:exported="true"
            android:label="ترتيب المفضلة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- favourites row from ADB (agents, optimize/dock.sh); DUMP = only the shell can send it -->
        <receiver
            android:name=".DockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.raad.sauditv.home.GET_DOCK" />
                <action android:name="com.raad.sauditv.home.LIST_APPS" />
                <action android:name="com.raad.sauditv.home.SET_DOCK" />
                <action android:name="com.raad.sauditv.home.RESET_DOCK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
