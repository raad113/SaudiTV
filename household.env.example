# Your household's settings for optimize/setup-new-tv.sh. Copy this file to household.env (git never tracks it:
# it may hold where you live) and edit it. bash reads it, so: no spaces around "=", quote values with spaces.
# A second TV with other cards or apps: copy it to household-tv2.env and run
#   HOUSEHOLD_ENV=household-tv2.env optimize/setup-new-tv.sh 192.168.x.y
# Anything left out keeps the default shown here.

# The city on screen (Arabic is fine), for prayer times and weather. Saudi cities: optimize/saver.sh cities; another
# country's biggest: optimize/saver.sh cities EG (any place works with its latitude and longitude)
CITY_NAME="الرياض"
LAT=24.6877
LON=46.7219
# The city's country (an ISO code: SA EG AE US GB…; all of them: optimize/saver.sh countries). Its prayer method,
# temperature unit and news follow it unless they are set below. Empty: left as it is (not set: as older builds, the
# method from the TV's time zone, °C).
COUNTRY=""
# The city's own time zone, for its prayer times (e.g. Africa/Cairo). Empty: the nearest bundled city's in COUNTRY.
CITY_TZ=""
# The TV's own time zone, its clock (checked, not sent: the apps follow the TV's).
TZ_ID=Asia/Riyadh
# «طريقة الحساب»: auto (the country's: SA Umm al-Qura, US/CA ISNA, EG Egyptian, KW Kuwait, QA Qatar, AE Dubai, Europe
# MWL, PK/IN/BD Karachi, TR Diyanet, the others MWL) or one of umm-al-qura isna egypt kuwait qatar dubai mwl karachi
# diyanet. Empty: left as it is.
METHOD=""
# The temperature: auto (the country's: °F in the US), c or f. Empty: left as it is.
UNITS=""
# «الدوري في الترتيب», the table card's league: auto (the first followed club's) or an id of optimize/saver.sh leagues
# (ksa.1 = دوري روشن, eng.1, esp.1, tsdb.4829 = the Egyptian league…). Empty: left as it is.
LEAGUE=""
# «أخبار <الدولة>», the news card's country: auto (the city's country) or a code (SA EG…). Empty: left as it is.
NEWS_COUNTRY=""

# Followed teams, in order: id:English name. TheSportsDB ids: optimize/saver.sh find-team الهلال; ESPN's (any league it
# carries, or fifa.friendly for national teams): optimize/saver.sh clubs eng.1, e.g. "E359@eng.1:Arsenal"
TEAMS=(
  "136137:Saudi Arabia"
  "136013:Al-Hilal"
  "136022:Al-Nassr"
  "136018:Al-Ittihad"
  "137721:Al-Ahli"
)

# The rotating card beside the screensaver's clock, and the one on the home screen (every 30 s). One or more of:
# prayers verse hadith forecast matches standings news local world tech shows (or none); news = the news of
# NEWS_COUNTRY, standings = the table of LEAGUE, local = the news of the city above, world = the world's news, verse = a
# verse of the Quran, hadith = a hadith of Sahih al-Bukhari
SAVER_PANELS=prayers,forecast,matches,standings,news,tech
HOME_PANELS=prayers,forecast,matches,standings,news,tech

# The home screen's favourites row, left to right (package names; apps not installed are left out).
# Empty: the home screen's own default. Every app on the TV: optimize/dock.sh apps
DOCK_APPS=""
# e.g. DOCK_APPS="com.google.android.youtube.tv net.mbc.shahidTV com.android.vending com.raad.sauditv.screensaver"

# «شكل الأرقام»: how numbers are written everywhere (the screen, the home screen, the settings): 0-9 (0 1 2 3) or
# arabic (٠ ١ ٢ ٣). Empty: the app's default (0-9).
NUMERALS=0-9

# The home screen's apps: TILE_SHAPE «شكل التطبيقات», rounded (banners with rounded corners) or circle (round app
# icons with their names); FOCUS_STYLE «شكل التحديد», how the focused app looks: google (a white ring, the others
# dimmed) or apple (lifted, with a soft shadow). Empty: the app's defaults (rounded, google).
TILE_SHAPE=rounded
FOCUS_STYLE=google

# The episodes card: lowest rating (0 6 6.5 7 7.5 8). Empty: the app's default (7).
MINRATING=""
# The screensaver page's auto-update from github.com/raad113/SaudiTV: on / off. Empty: the app's default (on).
AUTOUPDATE=""

# More apps to turn off (pm disable-user) or remove for the TV's user (asked first), on top of optimize/extra/.
# Space-separated package names. e.g. Chromecast and the remote's Assistant (frees ~50 MB on a 1 GB TV, but no
# casting from phones and no voice search): EXTRA_OFF="com.google.android.apps.mediashell com.google.android.katniss"
EXTRA_OFF=""
EXTRA_REMOVE=""

# Screen off this long after the last key press, in ms (10800000 = 3 h): the screensaver ends and the TV sleeps.
# Empty: the TV's own setting is left as it is.
SLEEP_TIMEOUT_MS=""
